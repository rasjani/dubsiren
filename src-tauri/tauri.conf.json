{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iTal Tone Dub Siren",
  "mainBinaryName": "iTal Tone Dub Siren",
  "version": "0.2.0",
  "identifier": "com.italtone.dubsiren",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Dub Siren",
        "width": 1000
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
